-- PARTE 3 - EXEMPLOS DE UPDATE / DELETE / SELECT DO ARQUIVO
-- ============================================================
-- UPDATE de exemplo
UPDATE CIDADE SET NOME='Marilia', UF='SP' WHERE ID = 1;
UPDATE 1
-- DELETE de exemplo
-- NOTA: essa instrução, executada tal como está no arquivo, falha
-- de propósito: a cidade ID=1 é referenciada pelo cliente HELENA
-- (CIDADE_ID=1), então o banco bloqueia a exclusão por integridade
-- referencial (erro de FOREIGN KEY). Isso é o comportamento correto
-- e esperado de um banco normalizado, por isso o DELETE foi mantido
-- e o erro documentado no arquivo de respostas, em vez de "forçado"
-- a funcionar.
DELETE FROM CIDADE WHERE ID = 1;
psql:/script.sql:149: ERROR:  update or delete on table "cidade" violates foreign key constraint "cliente_cidade_id_fkey" on table "cliente"
DETAIL:  Key (id)=(1) is still referenced from table "cliente".
-- SELECTs de exemplo (já refletem o UPDATE acima)
